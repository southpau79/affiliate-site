---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { products } from "../data/products.js";

const categories = ["All deals", "Electronics", "Home", "Fashion", "Beauty"];
const money = (value) => new Intl.NumberFormat("en-IN", {
  style: "currency",
  currency: "INR",
  maximumFractionDigits: 0
}).format(value);
---
<BaseLayout
  title="DealNest India | Hand-picked Product Deals"
  description="Browse hand-picked product deals across electronics, home, fashion and beauty."
>
  <SiteHeader />
  <main>
    <section class="hero">
      <div class="container hero-content">
        <p class="eyebrow">SMARTER SHOPPING STARTS HERE</p>
        <h1>Good finds.<br /><span>Better decisions.</span></h1>
        <p class="hero-copy">Explore hand-picked products and offers from stores you know.</p>
        <a class="button button-light" href="#deals">Explore deals <span aria-hidden="true">↓</span></a>
        <p class="hero-disclaimer">Prices and availability can change. Check the retailer before buying.</p>
      </div>
      <div class="hero-orb orb-one"></div>
      <div class="hero-orb orb-two"></div>
    </section>

    <section id="deals" class="container deals-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow eyebrow-dark">THE SHORTLIST</p>
          <h2>Deals worth a look</h2>
          <p class="muted">Curated picks, with the details up front.</p>
        </div>
        <label class="search-wrap">
          <span class="sr-only">Search products</span>
          <span aria-hidden="true">⌕</span>
          <input id="product-search" type="search" placeholder="Search deals..." autocomplete="off" />
        </label>
      </div>

      <div class="filters" role="group" aria-label="Filter by category">
        {categories.map((category, index) => (
          <button class:list={["filter-button", index === 0 && "is-active"]} type="button" data-category={category}>
            {category}
          </button>
        ))}
      </div>

      <div class="product-grid" id="product-grid">
        {products.map((product) => {
          const discount = product.originalPrice > product.price
            ? Math.round((1 - product.price / product.originalPrice) * 100)
            : 0;
          return (
            <article
              class="product-card"
              data-title={product.title.toLowerCase()}
              data-category={product.category}
            >
              <a class="product-image-link" href={product.affiliateUrl} target="_blank" rel="sponsored nofollow noopener" aria-label={`View ${product.title} at ${product.merchant}`}>
                <img class="product-image" src={product.image} alt={product.title} loading="lazy" />
                {product.badge && <span class="product-badge">{product.badge}</span>}
              </a>
              <div class="product-body">
                <div class="product-meta">
                  <span>{product.category}</span>
                  <span>{product.merchant}</span>
                </div>
                <h3>{product.title}</h3>
                <p class="product-description">{product.description}</p>
                <div class="price-row">
                  <strong>{money(product.price)}</strong>
                  {product.originalPrice > product.price && <del>{money(product.originalPrice)}</del>}
                  {discount > 0 && <span class="discount">{discount}% off*</span>}
                </div>
                <a class="button button-primary buy-button" href={product.affiliateUrl} target="_blank" rel="sponsored nofollow noopener">
                  View at store <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>
      <p id="empty-state" class="empty-state" hidden>No products match that search. Try another keyword or category.</p>
      <p class="sample-note">Starter preview: product information and prices are illustrative placeholders. Replace them with verified listings before publishing.</p>
    </section>

    <section class="trust-section">
      <div class="container trust-grid">
        <div><span class="trust-icon">⌕</span><h3>Easy to browse</h3><p>Find products by category or keyword.</p></div>
        <div><span class="trust-icon">₹</span><h3>Prices in rupees</h3><p>Clear pricing, with retailer details.</p></div>
        <div><span class="trust-icon">↗</span><h3>Shop with context</h3><p>Visit the retailer to confirm final price and availability.</p></div>
      </div>
    </section>
  </main>
  <SiteFooter />
  <script>
    const search = document.querySelector("#product-search");
    const cards = [...document.querySelectorAll(".product-card")];
    const filters = [...document.querySelectorAll(".filter-button")];
    const emptyState = document.querySelector("#empty-state");
    let activeCategory = "All deals";

    function updateProducts() {
      const term = search.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const matchesTerm = card.dataset.title.includes(term);
        const matchesCategory = activeCategory === "All deals" || card.dataset.category === activeCategory;
        const show = matchesTerm && matchesCategory;
        card.hidden = !show;
        if (show) visible++;
      });
      emptyState.hidden = visible > 0;
    }

    search.addEventListener("input", updateProducts);
    filters.forEach((button) => {
      button.addEventListener("click", () => {
        activeCategory = button.dataset.category;
        filters.forEach((item) => item.classList.toggle("is-active", item === button));
        updateProducts();
      });
    });
  </script>
</BaseLayout>

<style>
  :global(:root) { --ink: #102a43; --muted: #627d98; --line: #e3eaf1; --paper: #f7f9fc; --accent: #f4b942; }
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; color: var(--ink); background: #fff; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  :global(a) { color: inherit; }
  :global(button), :global(input) { font: inherit; }
  :global(.container) { width: min(1120px, calc(100% - 40px)); margin-inline: auto; }
  :global(.site-header) { background: #fff; border-bottom: 1px solid var(--line); }
  :global(.header-inner) { min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  :global(.brand) { display: inline-flex; align-items: center; gap: 10px; font-weight: 850; text-decoration: none; letter-spacing: -.04em; font-size: 1.2rem; }
  :global(.brand-mark) { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 12px; background: var(--ink); color: #fff; font-size: 1.15rem; }
  :global(.brand-accent) { color: #d18b00; }
  :global(nav) { display: flex; align-items: center; gap: 24px; }
  :global(nav a) { text-decoration: none; color: #486581; font-size: .92rem; font-weight: 650; }
  :global(nav a:hover) { color: #102a43; }
  .hero { position: relative; overflow: hidden; background: linear-gradient(115deg, #102a43, #174c67); color: #fff; }
  .hero-content { position: relative; z-index: 1; padding-block: 78px 72px; }
  .eyebrow { margin: 0 0 14px; color: #f7c75e; font-size: .73rem; letter-spacing: .16em; font-weight: 850; }
  h1 { max-width: 650px; margin: 0; font-size: clamp(2.7rem, 7vw, 5rem); line-height: .99; letter-spacing: -.065em; }
  h1 span { color: #f7c75e; }
  .hero-copy { max-width: 500px; color: #d9e6f2; font-size: 1.12rem; line-height: 1.7; margin: 22px 0 28px; }
  .button { min-height: 44px; padding: 12px 16px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; text-decoration: none; font-weight: 750; font-size: .92rem; transition: transform .15s ease, background .15s ease; }
  .button:hover { transform: translateY(-1px); }
  .button-light { background: #fff; color: var(--ink); }
  .hero-disclaimer { color: #b9ccdc; font-size: .78rem; margin-top: 24px; }
  .hero-orb { position: absolute; border-radius: 50%; border: 1px solid #ffffff20; pointer-events: none; }
  .orb-one { width: 410px; height: 410px; right: 6%; top: -150px; box-shadow: 0 0 0 45px #ffffff08, 0 0 0 90px #ffffff05; }
  .orb-two { width: 210px; height: 210px; right: 18%; bottom: -140px; background: #f7c75e12; }
  .deals-section { padding-block: 68px 76px; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 28px; }
  .eyebrow-dark { color: #bf7d00; }
  h2 { margin: 0; font-size: clamp(1.9rem, 4vw, 2.65rem); letter-spacing: -.05em; }
  .muted { color: var(--muted); margin: 10px 0 0; }
  .search-wrap { display: flex; align-items: center; gap: 10px; min-width: min(290px, 100%); padding: 0 14px; border: 1px solid #d6e0ea; border-radius: 12px; color: #829ab1; }
  .search-wrap input { width: 100%; border: 0; outline: 0; min-height: 46px; color: var(--ink); background: transparent; }
  .filters { display: flex; flex-wrap: wrap; gap: 9px; margin: 28px 0 24px; }
  .filter-button { cursor: pointer; border: 1px solid #d9e2ec; color: #486581; background: #fff; padding: 9px 14px; border-radius: 999px; font-size: .86rem; font-weight: 700; }
  .filter-button.is-active, .filter-button:hover { color: #fff; background: var(--ink); border-color: var(--ink); }
  .product-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
  .product-card { overflow: hidden; border: 1px solid var(--line); border-radius: 18px; background: #fff; display: flex; flex-direction: column; min-width: 0; transition: box-shadow .2s ease, transform .2s ease; }
  .product-card:hover { box-shadow: 0 14px 34px #102a4312; transform: translateY(-3px); }
  .product-card[hidden] { display: none; }
  .product-image-link { position: relative; display: block; background: #f1f5f9; aspect-ratio: 4 / 3; overflow: hidden; }
  .product-image { width: 100%; height: 100%; object-fit: cover; display: block; }
  .product-badge { position: absolute; top: 12px; left: 12px; background: #fff; color: #9a6700; border-radius: 7px; padding: 6px 8px; font-size: .69rem; font-weight: 850; }
  .product-body { padding: 16px; display: flex; flex: 1; flex-direction: column; }
  .product-meta { display: flex; justify-content: space-between; gap: 8px; color: #829ab1; font-size: .7rem; font-weight: 700; }
  .product-meta span:last-child { text-align: right; }
  h3 { font-size: 1rem; line-height: 1.4; margin: 12px 0 8px; letter-spacing: -.02em; }
  .product-description { color: var(--muted); font-size: .83rem; line-height: 1.5; margin: 0 0 18px; }
  .price-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 7px; margin-top: auto; margin-bottom: 15px; }
  .price-row strong { font-size: 1.2rem; letter-spacing: -.03em; }
  .price-row del { font-size: .8rem; color: #829ab1; }
  .discount { font-size: .72rem; font-weight: 800; color: #147d64; }
  .button-primary { background: var(--ink); color: #fff; width: 100%; }
  .button-primary:hover { background: #174c67; }
  .sample-note { margin-top: 24px; color: #829ab1; font-size: .78rem; line-height: 1.6; }
  .empty-state { padding: 40px 10px; text-align: center; color: var(--muted); }
  .trust-section { background: var(--paper); border-block: 1px solid var(--line); padding-block: 42px; }
  .trust-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .trust-grid > div { padding: 6px 0; }
  .trust-icon { display: grid; place-items: center; width: 38px; height: 38px; background: #fff; border: 1px solid var(--line); border-radius: 12px; font-size: 1.2rem; font-weight: 800; }
  .trust-grid h3 { margin: 14px 0 6px; }
  .trust-grid p { color: var(--muted); font-size: .88rem; line-height: 1.6; margin: 0; }
  :global(.site-footer) { background: #fff; }
  :global(.footer-inner) { display: flex; justify-content: space-between; align-items: start; gap: 24px; padding-block: 26px; color: #829ab1; font-size: .78rem; }
  :global(.footer-inner p) { margin: 0; }
  :global(.footer-note) { max-width: 480px; text-align: right; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (max-width: 900px) { .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .orb-one { right: -170px; } }
  @media (max-width: 600px) {
    :global(.container) { width: min(100% - 28px, 1120px); }
    :global(.header-inner) { min-height: 66px; flex-wrap: wrap; padding-block: 12px; }
    :global(nav) { gap: 13px; font-size: .8rem; }
    :global(nav a) { font-size: .8rem; }
    .hero-content { padding-block: 58px 48px; }
    .hero-copy { font-size: 1rem; }
    .section-heading { align-items: stretch; flex-direction: column; gap: 20px; }
    .search-wrap { min-width: 0; }
    .product-grid { gap: 10px; }
    .product-body { padding: 12px; }
    .product-meta { font-size: .62rem; }
    h3 { font-size: .92rem; }
    .product-description { font-size: .78rem; }
    .price-row { gap: 5px; }
    .price-row strong { font-size: 1.05rem; }
    .discount { font-size: .66rem; }
    .buy-button { padding: 10px 8px; font-size: .8rem; }
    .trust-grid { grid-template-columns: 1fr; gap: 22px; }
    :global(.footer-inner) { flex-direction: column; }
    :global(.footer-note) { text-align: left; }
  }
</style>
