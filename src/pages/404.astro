---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found | DealNest India" description="The page you requested could not be found.">
  <main class="not-found">
    <p class="code">404</p>
    <h1>This page went shopping.</h1>
    <p>We couldn't find the page you were looking for.</p>
    <a href="/">Return to deals</a>
  </main>
</BaseLayout>
<style>
  body { margin: 0; font-family: system-ui, sans-serif; color: #102a43; }
  .not-found { min-height: 100vh; display: flex; align-items: center; justify-content: center; flex-direction: column; text-align: center; padding: 24px; }
  .code { color: #bf7d00; font-weight: 900; letter-spacing: .18em; }
  h1 { font-size: clamp(2rem, 6vw, 3.5rem); letter-spacing: -.05em; margin: 8px 0; }
  p { color: #627d98; }
  a { margin-top: 18px; padding: 12px 16px; border-radius: 10px; background: #102a43; color: white; text-decoration: none; font-weight: 700; }
</style>
